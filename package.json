{
  "name": "bilibili-blocker-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter bilibili-blocker run build",
    "build:chrome": "pnpm --filter bilibili-blocker run build:chrome",
    "build:firefox": "pnpm --filter bilibili-blocker run build:firefox",
    "compile": "pnpm --filter bilibili-blocker run compile",
    "dev": "pnpm --filter bilibili-blocker run dev",
    "dev:firefox": "pnpm --filter bilibili-blocker run dev:firefox",
    "format": "oxfmt --write . && pnpm --filter bilibili-blocker exec tsx scripts/sort-rules.ts aislop.txt aivoice.txt catfish.txt clickbait.txt copycat.txt fakenews.txt finance.txt sales.txt spam.txt superstition.txt troll.txt",
    "format:check": "oxfmt --check .",
    "icon": "pnpm --filter bilibili-blocker run icon",
    "prepare": "husky",
    "test": "pnpm --filter bilibili-blocker run test",
    "test:ui": "pnpm --filter bilibili-blocker run test:ui",
    "test:watch": "pnpm --filter bilibili-blocker run test:watch",
    "zip": "pnpm --filter bilibili-blocker run zip",
    "zip:chrome": "pnpm --filter bilibili-blocker run zip:chrome",
    "zip:firefox": "pnpm --filter bilibili-blocker run zip:firefox"
  },
  "devDependencies": {
    "@guoyunhe/oxfmt-config": "^1.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,vue,json,jsonc,css,scss,less,htm,html,md,mdx,yaml,yml}": "oxfmt --write",
    "ext/rules/*.txt": "pnpm --filter bilibili-blocker exec tsx scripts/sort-rules.ts"
  }
}
